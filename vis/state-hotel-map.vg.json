{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 430,
  "title": {
    "text": "Hotel activity was concentrated in key Malaysian destinations",
    "subtitle": "Circle size shows selected hotel guest count by state in 2024",
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "font": "Inter",
    "subtitleFont": "Inter",
    "color": "#17324d",
    "subtitleColor": "#5f6f7f",
    "subtitlePadding": 6,
    "offset": 16
  },
  "params": [
    {
      "name": "SelectedGuestType",
      "value": "Total hotel guests",
      "bind": {
        "input": "select",
        "options": [
          "Total hotel guests",
          "Domestic hotel guests",
          "Foreign hotel guests"
        ],
        "name": "Select guest type: "
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": [109, 4.5],
    "scale": 1550,
    "translate": [350, 215]
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8f4f5",
        "stroke": "#c7d8dc",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "graticule": {
          "step": [5, 5]
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#d6e2e5",
        "strokeWidth": 0.55,
        "opacity": 0.7
      }
    },
    {
      "data": {
        "url": "data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f3eadf",
        "stroke": "#7b8794",
        "strokeWidth": 0.55
      }
    },
    {
      "data": {
        "url": "data/state-hotel-guests.csv"
      },
      "transform": [
        {
          "calculate": "datum.State == 'Kuala Lumpur' ? 3.139 : datum.State == 'Putrajaya' ? 2.9264 : datum.State == 'Selangor' ? 3.0738 : datum.State == 'Pulau Pinang' ? 5.4141 : datum.State == 'Perak' ? 4.5921 : datum.State == 'Kedah' ? 6.1184 : datum.State == 'Perlis' ? 6.4449 : datum.State == 'Negeri Sembilan' ? 2.7258 : datum.State == 'Melaka' ? 2.1896 : datum.State == 'Johor' ? 1.4854 : datum.State == 'Pahang' ? 3.8126 : datum.State == 'Terengganu' ? 5.3117 : datum.State == 'Kelantan' ? 5.25 : datum.State == 'Sabah' ? 5.9788 : datum.State == 'Labuan' ? 5.2831 : 1.5533",
          "as": "Latitude"
        },
        {
          "calculate": "datum.State == 'Kuala Lumpur' ? 101.6869 : datum.State == 'Putrajaya' ? 101.6964 : datum.State == 'Selangor' ? 101.5183 : datum.State == 'Pulau Pinang' ? 100.3288 : datum.State == 'Perak' ? 101.0901 : datum.State == 'Kedah' ? 100.3685 : datum.State == 'Perlis' ? 100.2048 : datum.State == 'Negeri Sembilan' ? 101.9424 : datum.State == 'Melaka' ? 102.2501 : datum.State == 'Johor' ? 103.7618 : datum.State == 'Pahang' ? 103.3256 : datum.State == 'Terengganu' ? 103.1324 : datum.State == 'Kelantan' ? 102.0 : datum.State == 'Sabah' ? 116.0753 : datum.State == 'Labuan' ? 115.2308 : 110.3592",
          "as": "Longitude"
        },
        {
          "calculate": "SelectedGuestType",
          "as": "Selected guest type"
        },
        {
          "calculate": "SelectedGuestType == 'Total hotel guests' ? toNumber(datum['Total in 2024']) : SelectedGuestType == 'Domestic hotel guests' ? toNumber(datum['Domestic in 2024']) : toNumber(datum['Foreign in 2024'])",
          "as": "Selected hotel guests"
        },
        {
          "calculate": "datum['Selected hotel guests'] / 1000000",
          "as": "Selected hotel guests in millions"
        },
        {
          "calculate": "toNumber(datum['Total Growth Percent(%)'])",
          "as": "Total growth"
        },
        {
          "calculate": "datum['Total growth'] >= 10 ? 'High growth' : datum['Total growth'] < 0 ? 'Decline' : 'Moderate growth'",
          "as": "Growth group"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.78,
        "stroke": "#ffffff",
        "strokeWidth": 1.3
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Selected hotel guests",
          "type": "quantitative",
          "title": "Hotel guests",
          "scale": {
            "range": [70, 1800]
          },
          "legend": {
            "orient": "bottom",
            "values": [0, 5000000, 10000000, 15000000],
            "format": "~s",
            "labelFont": "Inter",
            "titleFont": "Inter"
          }
        },
        "color": {
          "field": "Growth group",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": ["High growth", "Moderate growth", "Decline"],
            "range": ["#4F8F78", "#8FB8A8", "#B7C3CB"]
          },
          "legend": {
            "orient": "bottom",
            "labelFont": "Inter"
          }
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal"
          },
          {
            "field": "Selected guest type",
            "type": "nominal",
            "title": "Selected measure"
          },
          {
            "field": "Selected hotel guests in millions",
            "type": "quantitative",
            "title": "Hotel guests (millions)",
            "format": ".2f"
          },
          {
            "field": "Total growth",
            "type": "quantitative",
            "title": "Total growth (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state-hotel-guests.csv"
      },
      "transform": [
        {
          "calculate": "datum.State == 'Kuala Lumpur' ? 3.139 : datum.State == 'Pahang' ? 3.8126 : datum.State == 'Johor' ? 1.4854 : datum.State == 'Sabah' ? 5.9788 : datum.State == 'Pulau Pinang' ? 5.4141 : null",
          "as": "Latitude"
        },
        {
          "calculate": "datum.State == 'Kuala Lumpur' ? 101.6869 : datum.State == 'Pahang' ? 103.3256 : datum.State == 'Johor' ? 103.7618 : datum.State == 'Sabah' ? 116.0753 : datum.State == 'Pulau Pinang' ? 100.3288 : null",
          "as": "Longitude"
        },
        {
          "filter": "datum.Latitude != null"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 9,
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 700,
        "color": "#17324d"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "State"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Longitude": 104.3,
            "Latitude": 7.3,
            "Note": "Peninsular destinations show\nlarge domestic hotel activity"
          },
          {
            "Longitude": 116.4,
            "Latitude": 7.2,
            "Note": "Sabah also recorded\nstrong foreign growth"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 600,
        "lineBreak": "\n",
        "color": "#6f8090"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "Note"
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "background": "transparent",
    "view": {
      "stroke": null
    }
  }
}