{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 620,
  "height": 420,
  "title": {
    "text": "Major states had different hotel tourism profiles",
    "subtitle": "Radar comparison of selected state-level hotel guest indicators in 2024",
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "font": "Inter",
    "subtitleFont": "Inter",
    "color": "#17324d",
    "subtitleColor": "#5f6f7f",
    "subtitlePadding": 6,
    "offset": 16
  },
  "layer": [
    {
      "data": {
        "values": [
          {"Ring": 25, "Metric order": 1}, {"Ring": 25, "Metric order": 2}, {"Ring": 25, "Metric order": 3}, {"Ring": 25, "Metric order": 4}, {"Ring": 25, "Metric order": 5},
          {"Ring": 50, "Metric order": 1}, {"Ring": 50, "Metric order": 2}, {"Ring": 50, "Metric order": 3}, {"Ring": 50, "Metric order": 4}, {"Ring": 50, "Metric order": 5},
          {"Ring": 75, "Metric order": 1}, {"Ring": 75, "Metric order": 2}, {"Ring": 75, "Metric order": 3}, {"Ring": 75, "Metric order": 4}, {"Ring": 75, "Metric order": 5},
          {"Ring": 100, "Metric order": 1}, {"Ring": 100, "Metric order": 2}, {"Ring": 100, "Metric order": 3}, {"Ring": 100, "Metric order": 4}, {"Ring": 100, "Metric order": 5}
        ]
      },
      "transform": [
        {
          "calculate": "1.57079632679 - (datum['Metric order'] - 1) / 5 * 6.28318530718",
          "as": "Angle"
        },
        {
          "calculate": "cos(datum.Angle) * datum.Ring",
          "as": "x"
        },
        {
          "calculate": "sin(datum.Angle) * datum.Ring",
          "as": "y"
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "linear-closed",
        "strokeWidth": 1,
        "color": "#d8e2ea",
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {"domain": [-130, 130]},
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {"domain": [-130, 130]},
          "axis": null
        },
        "detail": {
          "field": "Ring",
          "type": "quantitative"
        },
        "order": {
          "field": "Metric order",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {"Metric order": 1},
          {"Metric order": 2},
          {"Metric order": 3},
          {"Metric order": 4},
          {"Metric order": 5}
        ]
      },
      "transform": [
        {
          "calculate": "1.57079632679 - (datum['Metric order'] - 1) / 5 * 6.28318530718",
          "as": "Angle"
        },
        {
          "calculate": "cos(datum.Angle) * 105",
          "as": "x"
        },
        {
          "calculate": "sin(datum.Angle) * 105",
          "as": "y"
        },
        {
          "calculate": "0",
          "as": "Center"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1,
        "color": "#d8e2ea",
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "Center",
          "type": "quantitative",
          "scale": {"domain": [-130, 130]},
          "axis": null
        },
        "y": {
          "field": "Center",
          "type": "quantitative",
          "scale": {"domain": [-130, 130]},
          "axis": null
        },
        "x2": {"field": "x"},
        "y2": {"field": "y"}
      }
    },
    {
      "data": {
        "url": "data/state-hotel-guests.csv"
      },
      "transform": [
        {
          "filter": "datum.State == 'Kuala Lumpur' || datum.State == 'Pahang' || datum.State == 'Johor' || datum.State == 'Selangor'"
        },
        {
          "calculate": "toNumber(datum['Total in 2024'])",
          "as": "Total hotel guests"
        },
        {
          "calculate": "toNumber(datum['Domestic in 2024'])",
          "as": "Domestic hotel guests"
        },
        {
          "calculate": "toNumber(datum['Foreign in 2024'])",
          "as": "Foreign hotel guests"
        },
        {
          "calculate": "toNumber(datum['Total Growth Percent(%)'])",
          "as": "Total growth"
        },
        {
          "calculate": "toNumber(datum['Foreign Growth Percent(%)'])",
          "as": "Foreign growth"
        },
        {
          "calculate": "datum['Domestic hotel guests'] / datum['Total hotel guests'] * 100",
          "as": "Domestic share"
        },
        {
          "calculate": "datum['Foreign hotel guests'] / datum['Total hotel guests'] * 100",
          "as": "Foreign share"
        },
        {
          "calculate": "datum['Total hotel guests'] / 21910522 * 100",
          "as": "Total guest strength"
        },
        {
          "calculate": "datum['Total growth'] / 19 * 100",
          "as": "Total growth score"
        },
        {
          "calculate": "(datum['Foreign growth'] + 15) / 54.4 * 100",
          "as": "Foreign growth score"
        },
        {
          "fold": [
            "Total guest strength",
            "Domestic share",
            "Foreign share",
            "Total growth score",
            "Foreign growth score"
          ],
          "as": ["Indicator", "Score"]
        },
        {
          "calculate": "datum.Indicator == 'Total guest strength' ? 'Total guests' : datum.Indicator == 'Domestic share' ? 'Domestic share' : datum.Indicator == 'Foreign share' ? 'Foreign share' : datum.Indicator == 'Total growth score' ? 'Total growth' : 'Foreign growth'",
          "as": "Display indicator"
        },
        {
          "calculate": "datum['Display indicator'] == 'Total guests' ? 1 : datum['Display indicator'] == 'Domestic share' ? 2 : datum['Display indicator'] == 'Foreign share' ? 3 : datum['Display indicator'] == 'Total growth' ? 4 : 5",
          "as": "Metric order"
        },
        {
          "calculate": "1.57079632679 - (datum['Metric order'] - 1) / 5 * 6.28318530718",
          "as": "Angle"
        },
        {
          "calculate": "cos(datum.Angle) * datum.Score",
          "as": "x"
        },
        {
          "calculate": "sin(datum.Angle) * datum.Score",
          "as": "y"
        }
