          "field": "Metric order",
          "type": "quantitative"
        },
        "detail": {
          "field": "State",
          "type": "nominal"
        },
        "color": {
          "field": "State",
          "type": "nominal",
          "scale": {
            "domain": ["Kuala Lumpur", "Pahang", "Johor", "Selangor"],
            "range": ["#17324d", "#d4941f", "#c56b3c", "#6f8090"]
