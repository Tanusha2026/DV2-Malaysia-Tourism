{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 620,
  "height": 360,
  "title": {
    "text": "China moved into Malaysia’s top three source markets",
    "subtitle": "Rank movement among the top 10 source markets, 2022–2024",
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "font": "Inter",
    "subtitleFont": "Inter",
    "color": "#17324d",
    "subtitleColor": "#5f6f7f",
    "subtitlePadding": 6,
    "offset": 16
  },
  "data": {
    "url": "data/source-market-bump.csv"
  },
  "transform": [
    {
      "calculate": "toString(datum.Year)",
      "as": "Year label"
    },
    {
      "calculate": "toNumber(datum.Rank)",
      "as": "Rank number"
    },
    {
      "calculate": "datum.Country == 'China' || datum.Country == 'Philippines' ? 'Moved up' : datum.Country == 'Thailand' || datum.Country == 'Brunei' || datum.Country == 'India' ? 'Moved down' : 'No rank change'",
      "as": "Overall movement"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": false,
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "Year label",
          "type": "ordinal",
          "sort": ["2022", "2023", "2024"],
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelColor": "#475569",
            "labelFont": "Inter"
          }
        },
        "y": {
          "field": "Rank number",
          "type": "quantitative",
          "scale": {
            "domain": [10.5, 0.5]
          },
          "axis": {
            "title": "Rank",
            "tickMinStep": 1,
            "labelFont": "Inter",
            "titleFont": "Inter",
            "labelColor": "#52616f",
            "titleColor": "#17324d"
          }
        },
        "detail": {
          "field": "Country",
          "type": "nominal"
        },
        "color": {
          "field": "Overall movement",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": ["Moved up", "Moved down", "No rank change"],
            "range": ["#6E3F1F", "#B9834A", "#D9C3A5"]
          },
          "legend": {
            "orient": "bottom",
            "labelFont": "Inter"
          }
        },
        "tooltip": [
          {
            "field": "Country",
            "type": "nominal"
          },
          {
            "field": "Year label",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "Rank number",
            "type": "quantitative",
            "format": ".0f",
            "title": "Rank"
          },
          {
            "field": "Overall movement",
            "type": "nominal",
            "title": "Overall movement"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 110
      },
      "encoding": {
        "x": {
          "field": "Year label",
          "type": "ordinal",
          "sort": ["2022", "2023", "2024"]
        },
        "y": {
          "field": "Rank number",
          "type": "quantitative",
          "scale": {
            "domain": [10.5, 0.5]
          }
        },
        "color": {
          "field": "Overall movement",
          "type": "nominal",
          "scale": {
            "domain": ["Moved up", "Moved down", "No rank change"],
            "range": ["#7B6FA8", "#8EA3AD", "#D5DEE5"]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Country",
            "type": "nominal"
          },
          {
            "field": "Year label",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "Rank number",
            "type": "quantitative",
            "format": ".0f",
            "title": "Rank"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum['Year label'] == '2024'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 600,
        "color": "#334155"
      },
      "encoding": {
        "x": {
          "field": "Year label",
          "type": "ordinal",
          "sort": ["2022", "2023", "2024"]
        },
        "y": {
          "field": "Rank number",
          "type": "quantitative",
          "scale": {
            "domain": [10.5, 0.5]
          }
        },
        "text": {
          "field": "Country"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Year label": "2024",
            "Rank number": 3,
            "Note": "China rose from\n6th to 3rd"
          },
          {
            "Year label": "2024",
            "Rank number": 4,
            "Note": "Thailand slipped\nfrom 3rd to 4th"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 85,
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 700,
        "lineBreak": "\n",
        "color": "#6f8090"
      },
      "encoding": {
        "x": {
          "field": "Year label",
          "type": "ordinal",
          "sort": ["2022", "2023", "2024"]
        },
        "y": {
          "field": "Rank number",
          "type": "quantitative",
          "scale": {
            "domain": [10.5, 0.5]
          }
        },
        "text": {
          "field": "Note"
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#e6edf2",
      "domainColor": "#888888",
      "tickColor": "#888888"
    }
  }
}